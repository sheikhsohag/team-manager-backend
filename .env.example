# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# ---- Database (MySQL) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=task_manager
DB_CONNECTION_LIMIT=10

# ---- Auth ----
# CHANGE THIS in production to a long random string
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10

# ---- Super Admin seed (NEVER hardcode production creds in source) ----
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe@123

# ---- Seed behaviour ----
# When true, the seeder also inserts demo companies/admins/users for a quick demo
SEED_DEMO_DATA=true
